# VITE_API_URL is intentionally EMPTY here.
# The Vite proxy (vite.config.js) forwards /api/... to Express on localhost:3001.
# This way the app works from any PC on the network without hardcoding IPs.
VITE_API_URL=

# Leave Supabase vars blank (or don't set them) to use local mode
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Local PostgreSQL connection settings
# !! Do NOT commit this file to git !!
DB_HOST=localhost
DB_PORT=5433
DB_NAME=FileMgt
DB_USER=postgres
DB_PASSWORD=root

# API server port (React frontend will call http://localhost:3001)
PORT=3001
